# JSON on an existing checkout must never become committable.
config/google_service_account.json

# --- User-owned source of truth (gitignored per spec) -----------------------
master_profile.yaml
master_profile.json
master_resume_extract.yaml
master_summaries.yaml
master_summaries_pool.yaml
answer_bank_seed.yaml

# Operator's resume/cover templates carry personal info + real hyperlinks
# (name, contact, GitHub/LinkedIn/certificate links). Operator-owned source,
# dropped in per instance (rule #21); never committed.
resumes/templates/

# --- Permanent audit trail (lives on Oracle Cloud VM disk, never committed) -
resumes/applied/

# --- Runtime data (ignore contents, keep directory structure) ---------------
data/sessions/*
!data/sessions/.gitkeep
data/manual_queue/*
!data/manual_queue/.gitkeep
data/logs/*
!data/logs/.gitkeep
# Layer 9 index + reports: derived from Postgres, and they contain company
# names, JD snippets and scores — never committed.
data/index/*
!data/index/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/pending_writes.jsonl
data/run.lock

