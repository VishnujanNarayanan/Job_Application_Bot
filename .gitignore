# --- Operator docs (personal / instance-specific, not committed) ------------
# CHANGELOG.md is deliberately NOT here: it records what changed in the code,
# so it belongs to the repo rather than to this instance.
job_automation_architecture.md
alembic.ini
TODO.md
PRD.md
CLAUDE.md

# --- Secrets & credentials --------------------------------------------------
.env
# Google was removed in v2, but keep this ignored: any leftover service-account
# JSON on an existing checkout must never become committable.
config/google_service_account.json

# --- User-owned source of truth (gitignored per spec) -----------------------
master_profile.yaml
master_profile.json
master_resume_extract.yaml
# Backups/variants of the profile carry the same personal data as the original
# and this repo is public — master_profile_old.yaml (2,705 lines) was sitting
# untracked and would have been swept into a "commit everything".
master_profile_*.yaml
# Generated resume material (bullets, skills pool) — personal content.
bullet_extract*.yaml
resume_extract*.yaml
master_summaries.yaml
master_summaries_pool.yaml
answer_bank_seed.yaml

# Operator's resume/cover templates carry personal info + real hyperlinks
# (name, contact, GitHub/LinkedIn/certificate links). Operator-owned source,
# dropped in per instance (rule #21); never committed.
resumes/templates/

# --- Permanent audit trail (lives on Oracle Cloud VM disk, never committed) -
resumes/applied/

# --- Runtime data (ignore contents, keep directory structure) ---------------
data/sessions/*
!data/sessions/.gitkeep
data/manual_queue/*
!data/manual_queue/.gitkeep
data/logs/*
!data/logs/.gitkeep
# Layer 9 index + reports: derived from Postgres, and they contain company
# names, JD snippets and scores — never committed.
data/index/*
!data/index/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/pending_writes.jsonl
data/run.lock

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python

# --- Test / type cache ------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtualenvs ------------------------------------------------------------
.venv/
venv/
env/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
# WSL/Windows download metadata (alternate data stream marker files)
*:Zone.Identifier

# --- Editors ----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# Rendered resumes, ANYWHERE in the tree — this repo is public and a resume
# carries the operator's real name, phone, email and links. resumes/ is already
# ignored, but a render written elsewhere for inspection (repo root, a scratch
# dir) was not, and `git add -A` would have taken it. No .pdf or .docx is
# tracked today, so a blanket rule costs nothing; un-ignore explicitly with
# `git add -f` if a genuine document ever needs committing.
*.pdf
*.docx
