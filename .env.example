# .env.example — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real credentials.

# --- Database (Neon PostgreSQL, free tier, 3GB) -----------------------------
# Get from Neon dashboard → Connection string. Requires sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DBNAME?sslmode=require

# --- LLM ---------------------------------------------------------------------
# The provider is set in config/config.yaml (llm.base_url + llm.model +
# llm.api_key_env). Any OpenAI-compatible endpoint works, so only the key for
# the provider you actually configured needs a value here.
#
# Default is Groq: free, no card, OpenAI-compatible. Sign up at
# https://console.groq.com and create a key.
GROQ_API_KEY=

# Alternatives, if you point llm.base_url at them instead:
#   Cerebras   https://cloud.cerebras.ai   (free, 1M tokens/day)
CEREBRAS_API_KEY=
#   OpenRouter https://openrouter.ai/keys  (mixed free/paid models)
OPENROUTER_API_KEY=
#   Gemini     https://aistudio.google.com/apikey
#   Note: prefer a NON-thinking model. Reasoning tokens bill as output, and a
#   reasoning model parsing 60 job ads cost ~20x what its token count implied.
GEMINI_API_KEY=

# Verify whichever you chose before relying on it:
#   python -m src.cli.llm_check --list    # model names the key can see
#   python -m src.cli.llm_check           # real structured call

# --- Telegram bot -----------------------------------------------------------
# Bot token: create via @BotFather on Telegram.
# Chat ID: send a message to your bot, then call getUpdates to find your ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub Actions dispatch (dashboard "Run on GitHub") ---------------------
# Lets the dashboard start a pipeline run on GitHub's runners, which keeps
# going if the laptop sleeps. Optional — leave blank to only run locally.
# Token: a fine-grained PAT with `actions: write` on this repository ONLY.
GITHUB_REPO=YourUser/Job_Application_Bot
GITHUB_TOKEN=

# --- Analytics --------------------------------------------------------------
# No secrets needed. Layer 9 writes local CSV/text files under data/ (paths in
# config/config.yaml). Google Sheets/Docs were removed in v2 — if you are
# upgrading, GOOGLE_SHEETS_ID, GOOGLE_DOC_ID and GOOGLE_APPLICATION_CREDENTIALS
# are now unused and can be deleted from your .env.

# --- AWS (Iteration 0.1 onward) --------------------------------------------
# Credentials MUST be for the `job-bot-runtime` IAM user only (minimal
# permissions per CLAUDE.md hard rule #19). Never use root credentials.
# Rotate quarterly. If exposed, rotate immediately via AWS Console.
#
# Setup order MUST be: billing safeguards first (see CLAUDE.md hard rule #11),
# then create job-bot-runtime user, then fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=job-bot-vishnujan-resumes
AWS_CLOUDWATCH_LOG_GROUP=/job-bot/runtime
AWS_CLOUDWATCH_NAMESPACE=JobBot

# --- Runtime ----------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
