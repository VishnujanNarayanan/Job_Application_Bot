# .env.example — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real credentials.

# --- Database (Neon PostgreSQL, free tier, 3GB) -----------------------------
# Get from Neon dashboard → Connection string. Requires sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DBNAME?sslmode=require

# --- LLM (Google AI Studio — Gemini 2.0 Flash, 1500 calls/day free) --------
GEMINI_API_KEY=

# --- Telegram bot -----------------------------------------------------------
# Bot token: create via @BotFather on Telegram.
# Chat ID: send a message to your bot, then call getUpdates to find your ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets + Docs ---------------------------------------------------
# Service account JSON is downloaded from GCP and placed at the path below.
# Share the target Sheet and Doc with the service account email.
GOOGLE_SHEETS_ID=
GOOGLE_DOC_ID=
GOOGLE_APPLICATION_CREDENTIALS=config/google_service_account.json

# --- Indeed (used once for manual session login) ----------------------------
# Cookies are saved to data/sessions/indeed.json after first login.
# This value is only needed for the initial setup step.
INDEED_EMAIL=

# --- Runtime ----------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
