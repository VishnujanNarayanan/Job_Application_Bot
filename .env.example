# .env.example — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real credentials.

# --- Database (Neon PostgreSQL, free tier, 3GB) -----------------------------
# Get from Neon dashboard → Connection string. Requires sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DBNAME?sslmode=require

# --- LLM (Google AI Studio — Gemini 2.5 Flash; see config/config.yaml) ------
# Free-tier RPD is PER-MODEL: flash = 250/day, flash-lite = 20/day. Link a
# billing account to the key's Cloud project for paid-tier limits.
GEMINI_API_KEY=

# --- Telegram bot -----------------------------------------------------------
# Bot token: create via @BotFather on Telegram.
# Chat ID: send a message to your bot, then call getUpdates to find your ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics --------------------------------------------------------------
# No secrets needed. Layer 9 writes local CSV/text files under data/ (paths in
# config/config.yaml). Google Sheets/Docs were removed in v2 — if you are
# upgrading, GOOGLE_SHEETS_ID, GOOGLE_DOC_ID and GOOGLE_APPLICATION_CREDENTIALS
# are now unused and can be deleted from your .env.

# --- AWS (Iteration 0.1 onward) --------------------------------------------
# Credentials MUST be for the `job-bot-runtime` IAM user only (minimal
# permissions per CLAUDE.md hard rule #19). Never use root credentials.
# Rotate quarterly. If exposed, rotate immediately via AWS Console.
#
# Setup order MUST be: billing safeguards first (see CLAUDE.md hard rule #11),
# then create job-bot-runtime user, then fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=job-bot-vishnujan-resumes
AWS_CLOUDWATCH_LOG_GROUP=/job-bot/runtime
AWS_CLOUDWATCH_NAMESPACE=JobBot

# --- Runtime ----------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
