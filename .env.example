# .env.example -- copy to .env and fill in your own values:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys, and never share your .env.
#
# Each variable is marked:
#   [REQUIRED]  the pipeline will not run without it
#   [OPTIONAL]  leave it blank and that feature is simply off
#
# Minimum to run locally: DATABASE_URL and one LLM key (GROQ_API_KEY).

# =============================================================================
# Database  [REQUIRED]
# =============================================================================
# PostgreSQL with the pgvector extension. Either:
#   - Neon (free tier, no install): https://neon.tech -> copy the connection string
#   - Local Postgres:  docker run -d --name jobbot-db -p 5432:5432 \
#                        -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
#     then: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Create the tables once with:  alembic upgrade head
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# =============================================================================
# LLM keys  [at least ONE is REQUIRED]
# =============================================================================
# Every job ad is parsed by an LLM. Providers take turns (config.yaml ->
# llm.rotation); any provider whose key is blank is skipped automatically.
# Check a key with:  python -m src.cli.llm_check <provider>

# [REQUIRED unless you use another provider] Groq -- free, no card.
# https://console.groq.com -> API Keys
GROQ_API_KEY=

# [OPTIONAL] Gemini on a FREE key -- free, no card. Create the key in a Google
# AI Studio project WITHOUT billing so it can never be charged.
# https://aistudio.google.com/apikey
GEMINI_FREE_API_KEY=

# [OPTIONAL] Gemini on a PAID key (billing enabled). Small cost per job.
# Leave blank to stay at $0.
GEMINI_API_KEY=

# [OPTIONAL] OpenRouter free models -- last-resort backup. Slow; 50 requests/day
# without credits. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [OPTIONAL] Present in config but switched off (no free plan available).
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# =============================================================================
# Telegram  [OPTIONAL]
# =============================================================================
# Sends each match to your phone with Apply / Resume buttons. Without it,
# matches are still saved; see them on the dashboard (http://localhost:8000).
#   1. Message @BotFather on Telegram -> /newbot -> copy the token.
#   2. Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# AWS  [OPTIONAL]
# =============================================================================
# S3 caches rendered resumes so Telegram links work while your computer is off.
# Without it, resumes are built on demand by the local endpoint. If you leave
# these blank, also set `prerender.enabled: false` in config/config.yaml.
# Use an IAM user limited to your bucket -- never root credentials.
# The bucket name itself goes in config/config.yaml (aws.s3_bucket).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Only read by `python -m src.cli.aws_check`:
AWS_S3_BUCKET=
# [OPTIONAL] CloudWatch logging; blank = off.
AWS_CLOUDWATCH_LOG_GROUP=
AWS_CLOUDWATCH_NAMESPACE=JobBot

# =============================================================================
# GitHub Actions  [OPTIONAL]
# =============================================================================
# Lets the dashboard's "Run on GitHub" button start a run on GitHub's servers.
# Token: fine-grained personal access token with `actions: write` on this
# repository only.
GITHUB_REPO=YourUser/Job_Application_Bot
GITHUB_TOKEN=

# =============================================================================
# Runtime  [OPTIONAL]
# =============================================================================
TZ=Asia/Kolkata
LOG_LEVEL=INFO
# Set to "json" to get raw JSON logs in a terminal instead of readable lines.
LOG_FORMAT=
